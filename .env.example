# PartsPilot settings. Copy to .env (pnpm run setup does this once), edit, then run
#   pnpm run setup     (again after changing the AI provider or embedding model)
# .env is gitignored: your keys stay on this computer.

# Which AI reads your photos and writes the build plans:
#   ollama  - free, private, runs on this PC (default)
#   openai  - any OpenAI-compatible API: OpenAI, Groq, OpenRouter, LM Studio, …
#   gemini  - Google Gemini API key (https://aistudio.google.com/apikey)
AI_PROVIDER=ollama

# --- ollama ---------------------------------------------------------------
# Install https://ollama.com, then:  ollama pull qwen2.5vl:7b  and  ollama pull nomic-embed-text
# Smaller PCs: qwen2.5vl:3b. Any vision model works; the embedding model must output 768 dims.
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- openai (any OpenAI-compatible API) ------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# A vision-capable chat model from your provider.
OPENAI_MODEL=
# Must output 768 dims or honour `dimensions` (OpenAI: text-embedding-3-small).
OPENAI_EMBED_MODEL=text-embedding-3-small
# If your API has no embeddings endpoint (e.g. Groq), embed with local Ollama instead:
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_API_KEY=
# and set OPENAI_EMBED_MODEL=nomic-embed-text

# --- gemini ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Max time per AI call in ms (local models on small GPUs can be slow).
AI_TIMEOUT_MS=600000
