# Local settings for `wrangler dev --env local`. Normally generated by `pnpm run setup`
# from the root .env — edit that instead. Never commit .dev.vars.
SUPABASE_SERVICE_ROLE_KEY=paste-local-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# "off" skips Turnstile; only honoured against a local Supabase.
TURNSTILE_SECRET=off
# gemini | openai (any OpenAI-compatible API, incl. Ollama) | mock (canned, for tests)
AI_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5vl:7b
OPENAI_EMBED_MODEL=nomic-embed-text
