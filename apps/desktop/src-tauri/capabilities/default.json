{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: sign-in deep link, notifications, autostart, open web links, copy code, keyring session. No shell, fs or http plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://127.0.0.1:*" }]
    },
    "clipboard-manager:allow-write-text",
    "keyring:allow-get-secret",
    "keyring:allow-set-secret",
    "keyring:allow-delete-secret"
  ]
}
