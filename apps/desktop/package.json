{
  "name": "@partspilot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:installer": "node scripts/gen-config.mjs && tauri build --config src-tauri/tauri.generated.json",
