    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-deep-link": "2.6.2",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@wokwi/elements": "1.9.2",
    "dompurify": "3.4.17",
    "lit": "3.3.3",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tauri-plugin-keyring-api": "0.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
