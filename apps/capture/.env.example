# Public values only — these are compiled into the PWA bundle.
# Never put a service-role key, JWT secret or Turnstile SECRET here (CI scans the bundle).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-local-anon-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# Cloudflare's published always-pass test site key (local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
