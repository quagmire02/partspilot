# Local Google sign-in. Copy to supabase/.env (gitignored), fill in, then restart the
# stack: pnpm --filter @partspilot/api db:stop && pnpm --filter @partspilot/api db:start
#
# Google Cloud console → Google Auth Platform → Clients → Create client → Web application
#   Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
# While the app is in "Testing", add your Google account under Audience → Test users.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
