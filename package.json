{
  "name": "partspilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/local.mjs setup",
    "start": "node scripts/local.mjs start",
    "stop": "node scripts/local.mjs stop",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "check:rls": "pnpm --filter @partspilot/security run check:rls",
    "check:bundles": "pnpm --filter @partspilot/security run check:bundles",
    "openapi": "pnpm --filter @partspilot/shared run openapi"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
